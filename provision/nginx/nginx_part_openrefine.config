    location /openrefine/4001/ {
        resolver 127.0.0.11;
        auth_basic "Restricted Content";
        auth_basic_user_file /.htpasswd_nginx/4001.htpasswd;
        rewrite ^/openrefine/4001/(.*)$ /$1 break;
        proxy_pass http://openrefine-4001/$1$is_args$args;
    }

