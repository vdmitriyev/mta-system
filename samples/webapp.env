# Settings of the mta-system web app.
# Copy to envs/ (task app:init-env) and change the values. Do not commit your copy.

# ---- mode ----
# development or production
TARGET_SERVER=development
# FastAPI docs (/docs, /redoc, /openapi.json). Default: on in development, off in production
#ENABLE_API_DOCS=false

# ---- secrets: use long random values, e.g. python -c "import secrets; print(secrets.token_hex(32))" ----
SECRET_KEY=change-me-session-secret
# Do not change these two after the first registration: the login links depend on them
HASH_KEY_HIDDEN=change-me-captcha-key
HASH_KEY_LINKS=change-me-link-key

# ---- course ----
COURSE_NAME_TITLE=My Course
# Users need this code to register
COURSE_SECURITY_CODE=CODE
# Name of the server as the users see it (links in e-mails, addresses of the services)
SERVER_FQDN=localhost
# E-mail addresses with admin rights, separated by ";"
SYSTEM_ADMINS=admin@example.org
# E-mail domains that can register, separated by ";" or "," (empty: all domains), e.g. uol.de;uni-oldenburg.de
ALLOWED_FQDN_FOR_EMAILS=
# Number of accounts that the admin prepares with one click
MAX_USER_ACCOUNTS_TO_CREATE=5

# ---- database of the app (SQLite) ----
MTAS_DB_PATH=data/mta-system.db

# ---- session cookie ----
# Default: true in production (the app runs behind HTTPS), false in development
#SESSION_COOKIE_SECURE=true
#SESSION_MAX_AGE_DAYS=30

# ---- e-mail (registration) ----
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=course@example.org
# Seconds to wait for the SMTP server. Check the connection with: task app:cli -- check-mail
#MAIL_TIMEOUT_SEC=10

# ---- services for the users ----
# In which services a new user gets an account is set on the admin page "Auto creation"
# (stored in the database, all off at the start), or: python -m app.cli auto-creation --on postgresql

# ---- PostgreSQL service ----
POSTGRESQL_DB_HOST=postgresql-service
POSTGRESQL_DB_HOST_PORT=5432
POSTGRESQL_DB_NAME=postgres
POSTGRESQL_ADMIN_USER=postgres
POSTGRESQL_ADMIN_PASSWORD=change-me-postgres
POSTGRESQL_DEMO_DB='db_demo'
POSTGRESQL_DEMO_USER=db_user_demo
POSTGRESQL_DEMO_PASSWORD=change-me-demo
POSTGRESQL_DEMO_USER_READONLY=db_user_demo_ro
POSTGRESQL_DEMO_USER_READONLY_PASSWORD=change-me-demo-ro

# ---- MariaDB service (WordPress) ----
#MARIADB_DB_HOST=mariadb-service
#MARIADB_DB_HOST_PORT=3306
#MARIADB_ADMIN_USER=root
#MARIADB_ADMIN_PASSWORD=change-me-mariadb

# ---- containers of the users ----
# The versions of the images that the app starts for each user (METABASE_VERSION,
# OPENREFINE_VERSION, WORDPRESS_VERSION) are in versions.env in the project folder.
# Change them there: compose and Task read the same file.
# Docker network of the containers (compose project name + "_mtas-network")
#DOCKER_NETWORK_NAME=mta-system_mtas-network
# Address of a Metabase container without the port, as the app reaches it
#METABASE_BASE_URL=http://metabase-
#METABASE_TRY_COUNT=3
#METABASE_TRY_SLEEP_SEC=30

# ---- nginx basic auth (OpenRefine, NiFi, pgAdmin 4) ----
#NGINX_BASIC_AUTH_DIR=.htpasswd_nginx
