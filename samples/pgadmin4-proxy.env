# Shared secret of nginx and pgAdmin 4. nginx sends it with each request to pgAdmin;
# pgAdmin accepts the user name from nginx (X-Forwarded-User) only with this secret.
# task app:init-env creates envs/pgadmin4-proxy.env with a random value.
# Make one yourself: python -c "import secrets; print(secrets.token_hex(32))"
PGADMIN_WEBSERVER_SECRET=<CHANGE-ME>
