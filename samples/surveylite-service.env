# SurveyLite service (provision/surveylite/compose.yml). Change every <CHANGE-ME>.

# Public address of the server: https://<SERVER_FQDN>. SurveyLite adds its path
# /surveylite (SURVEYLITE_URL_PREFIX in provision/surveylite/compose.yml) to the links.
SURVEYLITE_BASE_URL=https://localhost

SURVEYLITE_ADMIN_USER=admin
SURVEYLITE_ADMIN_PASSWORD=<CHANGE-ME>
SURVEYLITE_SECRET_KEY=<CHANGE-ME>
# API keys, separated by commas. The app uses one of them (SURVEYLITE_API_KEY).
SURVEYLITE_API_KEYS=<CHANGE-ME>
