# sqlmate service (compose.services.yml): sqlmate and its own PostgreSQL database.
# Change every <CHANGE-ME>. The app creates the accounts through the API of sqlmate.

# ---- API key of the app: the same value as SQLMATE_API_KEY in the env file of the app ----
# sqlmate stores it at start. It must start with smk_ and have at least 36 characters:
#   python -c "import secrets; print('smk_' + secrets.token_urlsafe(32))"
API_KEY=<CHANGE-ME>

# ---- secrets of sqlmate (long random values) ----
FLASK_SECRET_KEY=<CHANGE-ME>
HASH_KEY_HIDDEN=<CHANGE-ME>
HASH_KEY_LINKS=<CHANGE-ME>

# ---- the host of the login links: the same as SERVER_FQDN of the app ----
SERVER_FQDN=localhost
WEBUI_TITLE_NAME=sqlmate

# ---- admins of sqlmate (separated by ";"); the API cannot manage them ----
SYSTEM_ADMINS=admin@example.org

# ---- database of sqlmate (also read by the image "postgres") ----
POSTGRES_DB=sqlmate_db
POSTGRES_USER=sqlmate
POSTGRES_PASSWORD=<CHANGE-ME>
POSTGRES_DB_HOST_PORT=5432

# ---- sandbox database: the queries of the students run here ----
SM_SANDBOX_DB_NAME=sqlmate_sandbox_db
SM_SANDBOX_DB_USER=sqlmate_sandbox
SM_SANDBOX_DB_PASS=<CHANGE-ME>
SM_SANDBOX_DB_USER_READONLY=sqlmate_sandbox_ro
SM_SANDBOX_DB_PASS_READONLY=<CHANGE-ME>

# ---- PDF report ----
REPORT_COURSENAME=Course
REPORT_SEMESTER=Semester
REPORT_UNIVERSITY=University

# ---- e-mail (sqlmate sends none to the users of the app) ----
MAIL_SERVER=localhost
MAIL_PORT=587
