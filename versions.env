# Versions of the service images. No secrets, part of git.
# Read by the app, all "task" commands and the compose files.
# After a change: get the image, then restart the app (see docs/deployment.md).

# containers for each user
METABASE_VERSION=v0.57.3
OPENREFINE_VERSION=3.10.1
WORDPRESS_VERSION=latest
# installer of WordPress (WP-CLI)
WORDPRESS_CLI_VERSION=cli

# shared services
POSTGRESQL_VERSION=17.11
PGADMIN4_VERSION=9.19
# for WordPress. 12.3 (LTS) cannot open the data of 13.x.
MARIADB_VERSION=13.0.2

# sqlmate (optional): the image must be on the server
SQLMATE_VERSION=1.9.0

# SurveyLite (optional): the image must be on the server
SURVEYLITE_VERSION=0.21.0
