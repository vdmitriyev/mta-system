# Versions of the service images: the containers for each user (Metabase, OpenRefine,
# WordPress) and the shared services (PostgreSQL, pgAdmin 4).
# This is the only place for them. It holds no secrets and is part of git.
#
# Read by:
#   - the web app (lowest priority: a variable in the environment or in the
#     env file of the app wins over this file)
#   - Taskfile.yaml (all "task" commands, e.g. the docker compose calls)
#   - compose.services.yml, tests/testenv/compose.yaml, provision/wordpress/compose.yml
#     (with task, or: docker compose --env-file versions.env ...)
#
# After a change: build or pull the image, then restart the app.
#   all images: task services:update-all
#   Metabase:   task services:pull-metabase
#   OpenRefine: task services:build-openrefine
#   WordPress:  task services:pull-wordpress (also the installer image wordpress:<WORDPRESS_CLI_VERSION>)
#   MariaDB:    task services:pull-mariadb (an older version cannot open the data of a newer one)
#   PostgreSQL: task services:pull-postgresql (a new major version, e.g. 15 -> 17,
#               cannot open the old data: dump the databases first)
#   pgAdmin 4:  task services:pull-pgadmin4

METABASE_VERSION=v0.57.3
OPENREFINE_VERSION=3.10.1
WORDPRESS_VERSION=latest
# installer of WordPress (WP-CLI), a tag of the image "wordpress", e.g. cli or cli-2.12
WORDPRESS_CLI_VERSION=cli

# shared services (compose.services.yml)
POSTGRESQL_VERSION=17.11
PGADMIN4_VERSION=8.12
# MariaDB for WordPress (provision/wordpress/compose.yml).
# 13.0.2 was "latest" on 2026-11-11. The LTS version is 12.3: it cannot open data of 13.0.
MARIADB_VERSION=13.0.2

# sqlmate (provision/sqlmate/compose.yml) uses the image sqlmate:<SQLMATE_VERSION>
# on the server. SurveyLite (compose.services.yml) is built from its source folder.
# Both source folders are git repositories of their own. The version is the tag of the image: use the
# version in HISTORY.rst of the service. Relative folders start at the project folder.
#   sqlmate:    task services:build-sqlmate
#   SurveyLite: task services:build-surveylite
SQLMATE_VERSION=1.9.0
SQLMATE_SOURCE=./temp/sqlmate
SURVEYLITE_VERSION=0.21.0
SURVEYLITE_SOURCE=./temp/surveylite
